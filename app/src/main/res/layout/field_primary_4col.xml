<?xml version="1.0" encoding="utf-8"?>
<LinearLayout xmlns:android="http://schemas.android.com/apk/res/android"
    android:layout_width="match_parent"
    android:layout_height="match_parent"
    android:orientation="horizontal"
    android:background="#0D1424"
    android:padding="1dp">

    <LinearLayout
        android:layout_width="0dp"
        android:layout_height="match_parent"
        android:layout_weight="20"
        android:orientation="vertical"
        android:background="#111827">

        <FrameLayout android:layout_width="match_parent" android:layout_height="0dp" android:layout_weight="1">
            <TextView android:layout_width="wrap_content" android:layout_height="wrap_content" android:layout_gravity="top|start" android:layout_marginStart="2dp" android:layout_marginTop="1dp" android:text="♥" android:textColor="#CBD5E1" android:textSize="7sp" />
            <LinearLayout android:layout_width="match_parent" android:layout_height="match_parent" android:gravity="end|bottom" android:orientation="horizontal">
                <TextView android:id="@+id/tv_hr" android:layout_width="wrap_content" android:layout_height="wrap_content" android:layout_marginTop="2dp" android:text="NO" android:textColor="#FFFFFF" android:textSize="25sp" android:textStyle="bold" android:fontFamily="monospace" android:includeFontPadding="false" />
                <TextView android:id="@+id/tv_hr_unit" android:layout_width="wrap_content" android:layout_height="wrap_content" android:visibility="gone" android:text="" android:textColor="#CBD5E1" android:textSize="14sp" android:includeFontPadding="false" />
            </LinearLayout>
        </FrameLayout>

        <TextView android:layout_width="match_parent" android:layout_height="1dp" android:text="" android:background="#0D1424" />

        <FrameLayout android:layout_width="match_parent" android:layout_height="0dp" android:layout_weight="1">
            <TextView android:layout_width="wrap_content" android:layout_height="wrap_content" android:layout_gravity="top|start" android:layout_marginStart="2dp" android:layout_marginTop="1dp" android:text="↻" android:textColor="#CBD5E1" android:textSize="7sp" />
            <LinearLayout android:layout_width="match_parent" android:layout_height="match_parent" android:gravity="end|bottom" android:orientation="horizontal">
                <TextView android:id="@+id/tv_cadence" android:layout_width="wrap_content" android:layout_height="wrap_content" android:text="NO" android:textColor="#FFFFFF" android:textSize="25sp" android:textStyle="bold" android:fontFamily="monospace" android:includeFontPadding="false" />
                <TextView android:id="@+id/tv_cadence_unit" android:layout_width="wrap_content" android:layout_height="wrap_content" android:visibility="gone" android:text="" android:textColor="#CBD5E1" android:textSize="14sp" android:includeFontPadding="false" />
            </LinearLayout>
        </FrameLayout>
    </LinearLayout>

    <TextView android:layout_width="1dp" android:layout_height="match_parent" android:text="" android:background="#0D1424" />

    <FrameLayout
        android:layout_width="0dp"
        android:layout_height="match_parent"
        android:layout_weight="28"
        android:background="#111827">

        <LinearLayout android:layout_width="wrap_content" android:layout_height="wrap_content" android:layout_gravity="top|start" android:gravity="start" android:orientation="horizontal" android:layout_marginTop="1dp">
            <ImageView android:layout_width="10dp" android:layout_height="10dp" android:src="@drawable/ic_qext2_power" android:tint="#CBD5E1" />
            <TextView android:layout_width="wrap_content" android:layout_height="wrap_content" android:layout_marginStart="2dp" android:text="POWER" android:textColor="#CBD5E1" android:textSize="9sp" />
        </LinearLayout>

        <TextView android:id="@+id/tv_power_3" android:layout_width="match_parent" android:layout_height="match_parent" android:gravity="center" android:paddingStart="3dp" android:paddingTop="10dp" android:text="NO" android:textColor="#FFFFFF" android:textSize="38sp" android:fontFamily="monospace" />
        <TextView android:id="@+id/tv_power_4" android:layout_width="match_parent" android:layout_height="match_parent" android:gravity="center" android:paddingStart="3dp" android:paddingTop="10dp" android:visibility="gone" android:text="NO" android:textColor="#FFFFFF" android:textSize="33sp" android:fontFamily="monospace" />
        <TextView android:id="@+id/tv_power_5" android:layout_width="match_parent" android:layout_height="match_parent" android:gravity="center" android:paddingStart="3dp" android:paddingTop="10dp" android:visibility="gone" android:text="NO" android:textColor="#FFFFFF" android:textSize="27sp" android:fontFamily="monospace" />
    </FrameLayout>

    <TextView android:layout_width="1dp" android:layout_height="match_parent" android:text="" android:background="#0D1424" />

    <FrameLayout
        android:layout_width="0dp"
        android:layout_height="match_parent"
        android:layout_weight="30"
        android:background="#111827">

        <LinearLayout android:layout_width="wrap_content" android:layout_height="wrap_content" android:layout_gravity="top|start" android:gravity="start" android:orientation="horizontal" android:layout_marginTop="1dp">
            <ImageView android:layout_width="10dp" android:layout_height="10dp" android:src="@drawable/ic_qext2_speed" android:tint="#CBD5E1" />
            <TextView android:layout_width="wrap_content" android:layout_height="wrap_content" android:layout_marginStart="2dp" android:text="SPEED" android:textColor="#CBD5E1" android:textSize="9sp" />
        </LinearLayout>

        <TextView android:id="@+id/tv_speed_4" android:layout_width="match_parent" android:layout_height="match_parent" android:gravity="center" android:paddingTop="10dp" android:text="NO" android:textColor="#FFFFFF" android:textSize="34sp" android:fontFamily="monospace" />
        <TextView android:id="@+id/tv_speed_5" android:layout_width="match_parent" android:layout_height="match_parent" android:gravity="center" android:paddingTop="10dp" android:visibility="gone" android:text="NO" android:textColor="#FFFFFF" android:textSize="29sp" android:fontFamily="monospace" />
        <TextView android:id="@+id/tv_speed_6" android:layout_width="match_parent" android:layout_height="match_parent" android:gravity="center" android:paddingTop="10dp" android:visibility="gone" android:text="NO" android:textColor="#FFFFFF" android:textSize="23sp" android:fontFamily="monospace" />
    </FrameLayout>

    <TextView android:layout_width="1dp" android:layout_height="match_parent" android:text="" android:background="#0D1424" />

    <LinearLayout
        android:layout_width="0dp"
        android:layout_height="match_parent"
        android:layout_weight="22"
        android:orientation="vertical"
        android:background="#111827">

        <FrameLayout android:layout_width="match_parent" android:layout_height="0dp" android:layout_weight="1">
            <TextView android:layout_width="wrap_content" android:layout_height="wrap_content" android:layout_gravity="top|start" android:layout_marginStart="2dp" android:layout_marginTop="1dp" android:text="⚙" android:textColor="#CBD5E1" android:textSize="7sp" />
            <LinearLayout android:layout_width="match_parent" android:layout_height="match_parent" android:gravity="center" android:orientation="horizontal" android:paddingTop="12dp">
                <TextView android:id="@+id/tv_gear_front" android:layout_width="wrap_content" android:layout_height="wrap_content" android:text="NO" android:textColor="#FFFFFF" android:textSize="16sp" android:fontFamily="monospace" />
                <TextView android:id="@+id/tv_gear_x" android:layout_width="wrap_content" android:layout_height="wrap_content" android:text="x" android:textColor="#CBD5E1" android:textSize="12sp" />
                <TextView android:id="@+id/tv_gear_rear" android:layout_width="wrap_content" android:layout_height="wrap_content" android:text="NO" android:textColor="#FFFFFF" android:textSize="25sp" android:fontFamily="monospace" />
            </LinearLayout>
        </FrameLayout>

        <TextView android:layout_width="match_parent" android:layout_height="1dp" android:text="" android:background="#0D1424" />

        <FrameLayout android:id="@+id/grade_cell" android:layout_width="match_parent" android:layout_height="0dp" android:layout_weight="1">
            <TextView android:id="@+id/tv_grade_arrow" android:layout_width="wrap_content" android:layout_height="wrap_content" android:layout_gravity="top|start" android:layout_marginStart="2dp" android:layout_marginTop="1dp" android:text="▲" android:textColor="#CBD5E1" android:textSize="7sp" />
            <LinearLayout android:layout_width="match_parent" android:layout_height="match_parent" android:gravity="center" android:orientation="horizontal">
                <TextView android:id="@+id/tv_grade" android:layout_width="wrap_content" android:layout_height="wrap_content" android:text="NO" android:textColor="#FFFFFF" android:textSize="30sp" android:textStyle="bold" android:fontFamily="monospace" android:includeFontPadding="false" />
                <TextView android:id="@+id/tv_grade_unit" android:layout_width="wrap_content" android:layout_height="wrap_content" android:visibility="gone" android:text="" android:textColor="#CBD5E1" android:textSize="14sp" android:includeFontPadding="false" />
            </LinearLayout>
        </FrameLayout>
    </LinearLayout>

</LinearLayout>
