<?xml version="1.0" encoding="utf-8"?>
<LinearLayout xmlns:android="http://schemas.android.com/apk/res/android"
    android:layout_width="match_parent"
    android:layout_height="match_parent"
    android:orientation="vertical"
    android:padding="0dp"
    android:background="#111315">

    <LinearLayout
        android:layout_width="match_parent"
        android:layout_height="0dp"
        android:layout_weight="1"
        android:orientation="horizontal">

        <LinearLayout
            android:layout_width="0dp"
            android:layout_height="match_parent"
            android:layout_weight="1"
            android:orientation="vertical"
            android:background="#161A1E"
            android:padding="6dp">
            <TextView android:layout_width="match_parent" android:layout_height="wrap_content" android:text="NAWIERZCHNIA" android:textColor="#CBD5E1" android:textSize="9sp" android:includeFontPadding="false" />
            <LinearLayout android:layout_width="match_parent" android:layout_height="0dp" android:layout_weight="1" android:orientation="horizontal" android:gravity="center_vertical">
                <TextView android:layout_width="42dp" android:layout_height="wrap_content" android:text="ASFALT" android:textColor="#CBD5E1" android:textSize="9sp" android:includeFontPadding="false" />
                <ProgressBar android:id="@+id/pb_surface_paved" style="?android:attr/progressBarStyleHorizontal" android:layout_width="0dp" android:layout_height="9dp" android:layout_weight="1" android:max="100" android:progress="0" android:progressTint="#60A5FA" android:progressBackgroundTint="#243040" />
                <TextView android:id="@+id/tv_surface_paved_km" android:layout_width="46dp" android:layout_height="wrap_content" android:gravity="end" android:text="--" android:textColor="#FFFFFF" android:textSize="10sp" android:fontFamily="monospace" android:includeFontPadding="false" />
            </LinearLayout>
            <LinearLayout android:layout_width="match_parent" android:layout_height="0dp" android:layout_weight="1" android:orientation="horizontal" android:gravity="center_vertical">
                <TextView android:layout_width="42dp" android:layout_height="wrap_content" android:text="TEREN" android:textColor="#CBD5E1" android:textSize="9sp" android:includeFontPadding="false" />
                <ProgressBar android:id="@+id/pb_surface_offroad" style="?android:attr/progressBarStyleHorizontal" android:layout_width="0dp" android:layout_height="9dp" android:layout_weight="1" android:max="100" android:progress="0" android:progressTint="#FACC15" android:progressBackgroundTint="#243040" />
                <TextView android:id="@+id/tv_surface_offroad_km" android:layout_width="46dp" android:layout_height="wrap_content" android:gravity="end" android:text="--" android:textColor="#FFFFFF" android:textSize="10sp" android:fontFamily="monospace" android:includeFontPadding="false" />
            </LinearLayout>
        </LinearLayout>

        <FrameLayout
            android:id="@+id/stats_btn_gate"
            android:layout_width="0dp"
            android:layout_height="match_parent"
            android:layout_weight="1"
            android:background="#374151">
            <TextView
                android:id="@+id/tv_btn_gate"
                android:layout_width="match_parent"
                android:layout_height="match_parent"
                android:gravity="center"
                android:text="GATE"
                android:textColor="#FFFFFF"
                android:textSize="16sp"
                android:maxLines="1"
                android:ellipsize="none"
                android:textStyle="bold"
                android:fontFamily="monospace"
                android:includeFontPadding="false" />
        </FrameLayout>
    </LinearLayout>

    <LinearLayout
        android:layout_width="match_parent"
        android:layout_height="0dp"
        android:layout_weight="1"
        android:orientation="horizontal">

        <FrameLayout android:layout_width="0dp" android:layout_height="match_parent" android:layout_weight="1">
            <TextView android:id="@+id/tv_np_unit" android:layout_width="wrap_content" android:layout_height="wrap_content" android:layout_gravity="top|start" android:text="NP" android:textColor="#CBD5E1" android:textSize="9sp" android:includeFontPadding="false" />
            <TextView android:id="@+id/tv_np" android:layout_width="match_parent" android:layout_height="match_parent" android:gravity="end|bottom" android:text="--" android:textColor="#FFFFFF" android:textSize="25sp" android:fontFamily="monospace" android:textStyle="bold" android:includeFontPadding="false" />
        </FrameLayout>

        <FrameLayout android:layout_width="0dp" android:layout_height="match_parent" android:layout_weight="1">
            <TextView android:id="@+id/tv_ifeff_unit" android:layout_width="wrap_content" android:layout_height="wrap_content" android:layout_gravity="top|start" android:text="IFe" android:textColor="#CBD5E1" android:textSize="9sp" android:includeFontPadding="false" />
            <TextView android:id="@+id/tv_ifeff" android:layout_width="match_parent" android:layout_height="match_parent" android:gravity="end|bottom" android:text="--" android:textColor="#FFFFFF" android:textSize="25sp" android:fontFamily="monospace" android:textStyle="bold" android:includeFontPadding="false" />
        </FrameLayout>

        <FrameLayout android:layout_width="0dp" android:layout_height="match_parent" android:layout_weight="1">
            <TextView android:id="@+id/tv_vi_unit" android:layout_width="wrap_content" android:layout_height="wrap_content" android:layout_gravity="top|start" android:text="VI" android:textColor="#CBD5E1" android:textSize="9sp" android:includeFontPadding="false" />
            <TextView android:id="@+id/tv_vi" android:layout_width="match_parent" android:layout_height="match_parent" android:gravity="end|bottom" android:text="--" android:textColor="#FFFFFF" android:textSize="25sp" android:fontFamily="monospace" android:textStyle="bold" android:includeFontPadding="false" />
        </FrameLayout>
    </LinearLayout>

    <LinearLayout
        android:layout_width="match_parent"
        android:layout_height="0dp"
        android:layout_weight="1"
        android:orientation="horizontal">

        <FrameLayout android:layout_width="0dp" android:layout_height="match_parent" android:layout_weight="1">
            <TextView android:id="@+id/tv_xss_unit" android:layout_width="wrap_content" android:layout_height="wrap_content" android:layout_gravity="top|start" android:text="XSS" android:textColor="#CBD5E1" android:textSize="9sp" android:includeFontPadding="false" />
            <TextView android:id="@+id/tv_xss" android:layout_width="match_parent" android:layout_height="match_parent" android:gravity="end|bottom" android:text="--" android:textColor="#FFFFFF" android:textSize="25sp" android:fontFamily="monospace" android:textStyle="bold" android:includeFontPadding="false" />
        </FrameLayout>

        <FrameLayout android:layout_width="0dp" android:layout_height="match_parent" android:layout_weight="1">
            <TextView android:id="@+id/tv_rsrv_unit" android:layout_width="wrap_content" android:layout_height="wrap_content" android:layout_gravity="top|start" android:text="RSRV" android:textColor="#CBD5E1" android:textSize="9sp" android:includeFontPadding="false" />
            <TextView android:id="@+id/tv_rsrv" android:layout_width="match_parent" android:layout_height="match_parent" android:gravity="end|bottom" android:text="--" android:textColor="#FFFFFF" android:textSize="25sp" android:fontFamily="monospace" android:textStyle="bold" android:includeFontPadding="false" />
        </FrameLayout>

        <FrameLayout android:layout_width="0dp" android:layout_height="match_parent" android:layout_weight="1">
            <TextView android:id="@+id/tv_kcal_unit" android:layout_width="wrap_content" android:layout_height="wrap_content" android:layout_gravity="top|start" android:text="KCAL" android:textColor="#CBD5E1" android:textSize="9sp" android:includeFontPadding="false" />
            <TextView android:id="@+id/tv_kcal" android:layout_width="match_parent" android:layout_height="match_parent" android:gravity="end|bottom" android:text="--" android:textColor="#FFFFFF" android:textSize="25sp" android:fontFamily="monospace" android:textStyle="bold" android:includeFontPadding="false" />
        </FrameLayout>
    </LinearLayout>

    <LinearLayout
        android:layout_width="match_parent"
        android:layout_height="0dp"
        android:layout_weight="1"
        android:orientation="horizontal">

        <FrameLayout android:layout_width="0dp" android:layout_height="match_parent" android:layout_weight="1">
            <TextView android:id="@+id/tv_carb_unit" android:layout_width="wrap_content" android:layout_height="wrap_content" android:layout_gravity="top|start" android:text="CARB" android:textColor="#CBD5E1" android:textSize="9sp" android:includeFontPadding="false" />
            <TextView android:id="@+id/tv_carb_balance" android:layout_width="wrap_content" android:layout_height="wrap_content" android:layout_gravity="top|end" android:text="0g" android:textColor="#CBD5E1" android:textSize="12sp" android:fontFamily="monospace" android:includeFontPadding="false" />
            <TextView android:id="@+id/tv_carb" android:layout_width="match_parent" android:layout_height="match_parent" android:gravity="end|bottom" android:text="--" android:textColor="#FFFFFF" android:textSize="25sp" android:fontFamily="monospace" android:textStyle="bold" android:includeFontPadding="false" />
        </FrameLayout>

        <FrameLayout android:layout_width="0dp" android:layout_height="match_parent" android:layout_weight="1">
            <TextView android:id="@+id/tv_fluid_unit" android:layout_width="wrap_content" android:layout_height="wrap_content" android:layout_gravity="top|start" android:text="FLUID" android:textColor="#CBD5E1" android:textSize="9sp" android:includeFontPadding="false" />
            <TextView android:id="@+id/tv_fluid" android:layout_width="match_parent" android:layout_height="match_parent" android:gravity="end|bottom" android:text="--" android:textColor="#FFFFFF" android:textSize="25sp" android:fontFamily="monospace" android:textStyle="bold" android:includeFontPadding="false" />
        </FrameLayout>

        <FrameLayout android:layout_width="0dp" android:layout_height="match_parent" android:layout_weight="1">
            <TextView android:id="@+id/tv_cad_unit" android:layout_width="wrap_content" android:layout_height="wrap_content" android:layout_gravity="top|start" android:text="CAD śr" android:textColor="#CBD5E1" android:textSize="9sp" android:includeFontPadding="false" />
            <TextView android:id="@+id/tv_cad" android:layout_width="match_parent" android:layout_height="match_parent" android:gravity="end|bottom" android:text="--" android:textColor="#FFFFFF" android:textSize="25sp" android:fontFamily="monospace" android:textStyle="bold" android:includeFontPadding="false" />
        </FrameLayout>
    </LinearLayout>

    <LinearLayout
        android:layout_width="match_parent"
        android:layout_height="0dp"
        android:layout_weight="1"
        android:orientation="horizontal">

        <FrameLayout android:layout_width="0dp" android:layout_height="match_parent" android:layout_weight="1">
            <TextView android:id="@+id/tv_asc_done_unit" android:layout_width="wrap_content" android:layout_height="wrap_content" android:layout_gravity="top|start" android:text="UP" android:textColor="#CBD5E1" android:textSize="9sp" android:includeFontPadding="false" />
            <TextView android:id="@+id/tv_asc_done" android:layout_width="match_parent" android:layout_height="match_parent" android:gravity="end|bottom" android:text="--" android:textColor="#FFFFFF" android:textSize="25sp" android:fontFamily="monospace" android:textStyle="bold" android:includeFontPadding="false" />
        </FrameLayout>

        <FrameLayout android:layout_width="0dp" android:layout_height="match_parent" android:layout_weight="1">
            <TextView android:id="@+id/tv_asc_left_unit" android:layout_width="wrap_content" android:layout_height="wrap_content" android:layout_gravity="top|start" android:text="LEFT" android:textColor="#CBD5E1" android:textSize="9sp" android:includeFontPadding="false" />
            <TextView android:id="@+id/tv_asc_left" android:layout_width="match_parent" android:layout_height="match_parent" android:gravity="end|bottom" android:text="--" android:textColor="#FFFFFF" android:textSize="25sp" android:fontFamily="monospace" android:textStyle="bold" android:includeFontPadding="false" />
        </FrameLayout>

        <FrameLayout android:layout_width="0dp" android:layout_height="match_parent" android:layout_weight="1">
            <TextView android:id="@+id/tv_batdrain_unit" android:layout_width="wrap_content" android:layout_height="wrap_content" android:layout_gravity="top|start" android:text="BAT/h" android:textColor="#CBD5E1" android:textSize="9sp" android:includeFontPadding="false" />
            <TextView android:id="@+id/tv_batdrain" android:layout_width="match_parent" android:layout_height="match_parent" android:gravity="end|bottom" android:text="--" android:textColor="#FFFFFF" android:textSize="25sp" android:fontFamily="monospace" android:textStyle="bold" android:includeFontPadding="false" />
        </FrameLayout>
    </LinearLayout>

    <LinearLayout
        android:layout_width="match_parent"
        android:layout_height="0dp"
        android:layout_weight="1"
        android:orientation="horizontal">

        <FrameLayout android:layout_width="0dp" android:layout_height="match_parent" android:layout_weight="1">
            <TextView android:id="@+id/tv_avggross_unit" android:layout_width="wrap_content" android:layout_height="wrap_content" android:layout_gravity="top|start" android:text="Vśr B" android:textColor="#CBD5E1" android:textSize="9sp" android:includeFontPadding="false" />
            <TextView android:id="@+id/tv_avggross" android:layout_width="match_parent" android:layout_height="match_parent" android:gravity="end|bottom" android:text="--" android:textColor="#FFFFFF" android:textSize="25sp" android:fontFamily="monospace" android:textStyle="bold" android:includeFontPadding="false" />
        </FrameLayout>

        <FrameLayout android:layout_width="0dp" android:layout_height="match_parent" android:layout_weight="1">
            <TextView android:id="@+id/tv_stops_unit" android:layout_width="wrap_content" android:layout_height="wrap_content" android:layout_gravity="top|start" android:text="POSTOJE" android:textColor="#CBD5E1" android:textSize="9sp" android:includeFontPadding="false" />
            <TextView android:id="@+id/tv_stops" android:layout_width="match_parent" android:layout_height="match_parent" android:gravity="end|bottom" android:text="--" android:textColor="#FFFFFF" android:textSize="25sp" android:fontFamily="monospace" android:textStyle="bold" android:includeFontPadding="false" />
        </FrameLayout>

        <FrameLayout android:layout_width="0dp" android:layout_height="match_parent" android:layout_weight="1">
            <TextView android:id="@+id/tv_eta_unit" android:layout_width="wrap_content" android:layout_height="wrap_content" android:layout_gravity="top|start" android:text="ETA" android:textColor="#CBD5E1" android:textSize="9sp" android:includeFontPadding="false" />
            <TextView android:id="@+id/tv_eta" android:layout_width="match_parent" android:layout_height="match_parent" android:gravity="end|bottom" android:text="--" android:textColor="#FFFFFF" android:textSize="25sp" android:fontFamily="monospace" android:textStyle="bold" android:includeFontPadding="false" />
        </FrameLayout>
    </LinearLayout>

</LinearLayout>
