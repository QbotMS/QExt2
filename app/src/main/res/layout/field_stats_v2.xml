<?xml version="1.0" encoding="utf-8"?>
<FrameLayout xmlns:android="http://schemas.android.com/apk/res/android"
    android:layout_width="match_parent"
    android:layout_height="match_parent"
    android:background="#2A3038">

    <ImageView
        android:id="@+id/iv_stats_v2"
        android:layout_width="match_parent"
        android:layout_height="match_parent"
        android:scaleType="fitXY"
        android:contentDescription="STATS v2" />

    <!-- 2026-10-16: przezroczysta strefa dotyku nad komorka BRAMA (wiersz 565..650 z 760, lewa polowa) -->
    <LinearLayout
        android:layout_width="match_parent"
        android:layout_height="match_parent"
        android:orientation="vertical">

        <TextView
            android:layout_width="match_parent"
            android:layout_height="0dp"
            android:layout_weight="565" />

        <LinearLayout
            android:layout_width="match_parent"
            android:layout_height="0dp"
            android:layout_weight="108"
            android:orientation="horizontal">

            <TextView
                android:id="@+id/stats_v2_gate_tap"
                android:layout_width="0dp"
                android:layout_height="match_parent"
                android:layout_weight="211"
                android:contentDescription="BRAMA" />

            <TextView
                android:id="@+id/stats_v2_light_tap"
                android:layout_width="0dp"
                android:layout_height="match_parent"
                android:layout_weight="269"
                android:contentDescription="SWIATLO" />
        </LinearLayout>

        <TextView
            android:layout_width="match_parent"
            android:layout_height="0dp"
            android:layout_weight="87" />
    </LinearLayout>
</FrameLayout>
